# Copy to .env and adjust for your machine.
# Inside docker compose the app reaches Postgres at host "db";
# from your own computer use "localhost".
DATABASE_URL=postgresql+psycopg2://appuser:apppassword@localhost:5432/secure_users

# Signing key for login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
